# Copy to backend/.env and fill in real values. backend/.env is gitignored.

# --- Local Docker Postgres (default; used by docker-compose) ---
DATABASE_URL=postgresql+psycopg://codephoenix:codephoenix@db:5432/codephoenix

# --- Hosted Supabase Postgres (alternative) ---
# Use the SESSION POOLER connection (IPv4, port 5432), NOT the direct
# db.<ref>.supabase.co host — that endpoint is IPv6-only and will not resolve
# on most local/hosting networks. Get the string from the Supabase dashboard:
# Connect -> Connection string -> Session pooler. Convert the scheme to
# "postgresql+psycopg" and append "?sslmode=require". SINGLE-QUOTE the value if
# the password contains a "$" so it is not treated as dotenv interpolation.
# DATABASE_URL='postgresql+psycopg://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require'

SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
